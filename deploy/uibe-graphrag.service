[Unit]
Description=AI Tutor GraphRAG Service
After=network.target postgresql.service

[Service]
WorkingDirectory=/home/flaskappuser/Desktop/NewDisk_2T/aitutor
ExecStart=/home/flaskappuser/Desktop/NewDisk_2T/aitutor/.venv/bin/uvicorn graphrag_service.main:app --host 127.0.0.1 --port 8100
Restart=always
RestartSec=5
User=flaskappuser
EnvironmentFile=/home/flaskappuser/Desktop/NewDisk_2T/aitutor/.env
# main.py 通过 subprocess 调用 graphrag CLI，需要 venv 的 bin 在 PATH 上
Environment="PATH=/home/flaskappuser/Desktop/NewDisk_2T/aitutor/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# 资源限制
MemoryMax=4G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
