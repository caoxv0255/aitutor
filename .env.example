# .env.example — aitutor 生产环境变量模板
#
# 用法: cp .env.example .env, 然后填实际值
# 生产部署: 必须替换 JWT_SECRET 为 ≥32 字符随机字符串
#
# 必填: JWT_SECRET, DATABASE_URL, EMBEDDING_BASE_URL, EMBEDDING_MODEL
# 可选: DASHSCOPE_API_KEY (LLM), LITELLM_API_KEY (proxy), GRAPHRAG_API_URL (图谱)

# ── Server ─────────────────────────────────────────────────────
# 端口 (Docker 内部用 3000, 主机映射靠 PORT)
PORT=3002

# CORS 允许 origin (逗号分隔)
# 生产: aitutor.uibe.online,https://aitutor.uibe.online
ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# NODE_ENV (dev | production)
NODE_ENV=production

# SERVE_F3 (true 启用 F3 前端路由 /f3/*, production 应为 true)
SERVE_F3=true

# ── Database ──────────────────────────────────────────────────
# PostgreSQL 连接串 (pgvector + Apache AGE 扩展)
DATABASE_URL=postgresql://aitutor:CHANGE_ME@db:5432/aitutor_db

# ── JWT (必填, 生产环境必须强随机) ──────────────────────────────
# 至少 32 字符, 不能用默认值
# 生成: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING_xxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=7d

# ── Embedding (必填) ───────────────────────────────────────────
# D068 (2026-08-17): 默认使用 bge-m3 (1024 维)
# 三种 provider: ollama (本地) | local (sentence-transformers) | remote (DashScope)
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMS=1024
# EMBEDDING_API_KEY  # ollama 不需要; remote 模式才需要

# ── LLM Proxy (可选, 仅启用 /api/proxy 时需要) ─────────────────
# 阿里云 DashScope (qwen 系列)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek (备选)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Redis (可选, 不配置则使用内存缓存) ─────────────────────────
# REDIS_URL=redis://redis:6379

# ── GraphRAG (可选) ─────────────────────────────────────────────
# GRAPHRAG_API_URL=
# GRAPHRAG_API_KEY=

# ── LiteLLM (可选) ─────────────────────────────────────────────
# LITELLM_API_KEY=
# LITELLM_BASE_URL=

# ── Server 配置 ────────────────────────────────────────────────
# 代理信任 (nginx 反代时设置)
# TRUST_PROXY=loopback

# Docker 端口映射 (主机端口)
DB_PORT=5432