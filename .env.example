# .env.example — aitutor 生产环境变量模板
#
# 用法: cp .env.example .env, 然后填实际值
# 生产部署: 必须替换 JWT_SECRET 为 ≥32 字符随机字符串
#
# 必填: JWT_SECRET, DATABASE_URL, EMBEDDING_BASE_URL, EMBEDDING_MODEL
# 可选: DASHSCOPE_API_KEY (LLM), LITELLM_API_KEY (proxy), GRAPHRAG_API_URL (图谱)
#
# ⚠️ 轮换须知 (2026-09-22): 本仓库 git 历史里曾内联过真实凭据, 且已推送到公共
#    GitHub 远端。这些值一律视为**已泄露**, 必须到各家后台吊销/轮换 —— 改代码
#    读环境变量只防新增, 不撤销既有泄露。
#    完整清单与操作顺序见: docs/security/credential-rotation.md
#    本文件只填占位符, 严禁写入真实值 (仓库里唯一被跟踪的 .env* 就是本模板)。

# ── Server ─────────────────────────────────────────────────────
# 端口 (Docker 内部用 3000, 主机映射靠 PORT)
PORT=3002

# 服务端内部自调用基址 (2026-09-22 SSRF 修复 F1–F3 引入):
# essay 批改/转写等服务端 fetch 自身 /api/proxy 时使用。不设时默认
# http://127.0.0.1:${PORT} —— 通常无需配置; 仅当服务跑在非常规网络
# 位置 (如需要经本机域名访问自身) 时才覆盖。严禁取自请求头。
# SELF_BASE_URL=http://127.0.0.1:3002

# CORS 允许 origin (逗号分隔)
# 生产: aitutor.uibe.online,https://aitutor.uibe.online
ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# 作文图片 URL 的宿主白名单 (逗号分隔, 可写 origin 或裸 host)
#   作文批改/转写会把入参里的图片地址交给视觉模型按地址回抓, 不限制宿主等于开放
#   一个 SSRF 探测面。这一项**只管图片来源**, 与上面的 ALLOWED_ORIGINS (页面来源)
#   是两件事: 前端跑在 staging / preview 隧道域名上时, 只需把该域名加到这里,
#   不必改动 CORS。
#   不设时回退到 ALLOWED_ORIGINS + SELF_BASE_URL 的 host (兼容现有部署);
#   localhost / 127.0.0.1 / ::1 与 SELF_BASE_URL 的 host 恒定放行。
#   只比对 hostname, 不比对端口。
#ESSAY_IMAGE_HOSTS=https://aitutor.example.com,https://staging.example.com

# NODE_ENV (dev | production)
NODE_ENV=production

# SERVE_F3 (true 启用 F3 前端路由 /f3/*, production 应为 true)
SERVE_F3=true

# ── Database ──────────────────────────────────────────────────
# PostgreSQL 连接串 (pgvector + Apache AGE 扩展)
DATABASE_URL=postgresql://aitutor:CHANGE_ME@db:5432/aitutor_db
# 试卷解析类脚本(parse-* / retry-* / batch-parse-* / storage-service / ingest_local_embedding)
# 用的库可能与主应用不同; 不设置时回落到 DATABASE_URL, 两者都缺则脚本直接报错退出。
# 2026-09-21: 这些脚本里曾硬编码 postgres 口令, 已全部移除 —— 不要把凭据写回代码。
# 2026-09-22: 该口令至今未轮换, 详见 docs/security/credential-rotation.md (H1)。
PAPERS_DB_URL=CHANGE_ME
# docker-compose.yml 的 db 容器口令 (2026-09-22 B4: compose 不再有字面量默认值,
# 缺失即启动失败)。DATABASE_URL / PAPERS_DB_URL 里的口令应与本值一致。
POSTGRES_PASSWORD=CHANGE_ME

# ── JWT (必填, 生产环境必须强随机) ──────────────────────────────
# 至少 32 字符, 不能用默认值
# 生成: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING_xxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=7d

# ── Embedding (必填) ───────────────────────────────────────────
# D068 (2026-08-17): 默认使用 bge-m3 (1024 维)
# 三种 provider: ollama (本地) | local (sentence-transformers) | remote (DashScope)
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMS=1024
# EMBEDDING_API_KEY  # ollama 不需要; remote 模式才需要

# ── LLM Proxy (可选, 仅启用 /api/proxy 时需要) ─────────────────
# 阿里云 DashScope (qwen 系列)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek (备选)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Redis (可选, 不配置则使用内存缓存) ─────────────────────────
# REDIS_URL=redis://redis:6379

# ── GraphRAG (可选) ─────────────────────────────────────────────
# GRAPHRAG_API_URL=
# 2026-09-22: scripts/setup_graphrag.sh 里曾内联 sk- 前缀 key, 至今未吊销 —— 必须轮换。
#
# 2026-09-23: LLM 与 embedding 已拆成两套端点。
#   LLM      走 MiniMax CN (与 Node 侧 services/llm.js 的 MINIMAX_ENDPOINT 同源),
#            base=https://api.minimaxi.com/v1, 模型 MiniMax-M2.7 / MiniMax-M2.7-highspeed / MiniMax-M2。
#   embedding 走本机 Ollama 的 bge-m3-cpu (CPU 变体, 见 graphrag_service/Modelfile.bge-m3-cpu;
#            默认 GPU 在本机会 OOM), base=http://127.0.0.1:11434/v1。
# GRAPHRAG_API_KEY 不设时, graphrag_service/config.py 自动回退到下面的 MINIMAX_API_KEY
# —— 不要为了"配齐"把同一把 key 抄成两份, 那只会多一处要轮换的地方。
#GRAPHRAG_API_KEY=sk-CHANGE_ME
GRAPHRAG_API_BASE=https://api.minimaxi.com/v1
GRAPHRAG_MODEL=MiniMax-M2.7
GRAPHRAG_EMBEDDING_API_BASE=http://127.0.0.1:11434/v1
GRAPHRAG_EMBEDDING_MODEL=bge-m3-cpu
# Ollama 不校验 key, 但 GraphRAG 的 openai provider 要求非空, 保持占位值即可。
GRAPHRAG_EMBEDDING_API_KEY=ollama

# ── MiniMax (可选, 无 DASHSCOPE key 时自动成为默认文本模型) ──────
# MINIMAX_API_KEY=

# ── Ollama (可选, 本地视觉兜底; Ollama 不校验, 仅需占位通过 keyEnv 检查) ──
# OLLAMA_API_KEY=

# ── Obsidian 知识库同步 (可选) ──────────────────────────────────
# scripts/sync-knowledge-to-obsidian.js 用; 2026-09-22: 旧 64 位 hex token 未吊销。
# OBSIDIAN_API_TOKEN=

# ── push_to_uibe.sh 的 git 远端 (含凭据的完整 URL) ──────────────
# 2026-09-22: 这两个 URL 里曾内联 OS 用户口令, 至今未轮换 —— 换 OS 口令后同步更新。
# LAN_REMOTE=http://user:CHANGE_ME@<lan-host>/aitutor.git
# PUB_REMOTE=https://user:CHANGE_ME@<pub-host>/aitutor.git

# ── LiteLLM (可选) ─────────────────────────────────────────────
# LITELLM_API_KEY=
# LITELLM_BASE_URL=

# ── Server 配置 ────────────────────────────────────────────────
# 代理信任 (nginx 反代时设置)
# TRUST_PROXY=loopback

# Docker 端口映射 (主机端口)
DB_PORT=5432
# ── 新主前端树路由 (Q3: 新树优先 + 旧树兜底 + 一键回滚, 2026-09-21) ──
# NEW_TREE=off          回滚到"全部路径走旧树", 新页仅 /v2/ 可达
# NEW_TREE_PAGES=a.html,b.html   只接管列举的页面(渐进放量 / 缩小射程)
# 默认接管 frontend-v2/ 下已按新架构重建并通过验收的页面。
# 注意: 新增页面要同时更新 server.js 的 DEFAULT_NEW_TREE_PAGES —— 门禁
# scripts/check-new-tree-routing.mjs 会校验"列表里的页确实由新树服务"。
# NEW_TREE=on
# NEW_TREE_PAGES=login.html,register.html
