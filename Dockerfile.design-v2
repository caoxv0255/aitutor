# Dockerfile.design-v2
# 部署 docs/design/ 22 页 (PM-BRIEF v2 完整) 到独立端口
# 与 F3 旧版 (3002) 共存, 共享 PostgreSQL 真实数据

FROM node:22-alpine AS base
WORKDIR /app

# 安装依赖
COPY package.json package-lock.json* ./
RUN npm ci --production --silent 2>/dev/null || npm install --production --silent

# 复制核心代码
COPY server.js ./
COPY api ./api
COPY database ./database
COPY scripts ./scripts
COPY services ./services
COPY deploy ./deploy
COPY .env* ./
COPY docs/design ./docs/design

# 入口脚本: 同时服务 API (来自 api/) 和 design v2 静态文件
COPY docker-entrypoint.design-v2.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.design-v2.sh

ENV NODE_ENV=production
ENV PORT=3001
ENV SERVE_DESIGN_V2=true
EXPOSE 3001

ENTRYPOINT ["docker-entrypoint.design-v2.sh"]
CMD ["node", "server.js"]
