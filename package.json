{
  "name": "ai-tutor-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:win": "node server.js",
    "dev": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint api/ server.js tests/",
    "lint:fix": "eslint api/ server.js tests/ --fix",
    "format": "prettier --write \"api/**/*.js\" server.js \"tests/**/*.js\"",
    "format:check": "prettier --check \"api/**/*.js\" server.js \"tests/**/*.js\"",
    "sync": "node scripts/sync-knowledge.js",
    "sync:stats": "node scripts/sync-knowledge.js stats",
    "sync:obsidian": "node scripts/sync-knowledge.js sync",
    "sync:graphrag": "node scripts/sync-knowledge.js sync-back",
    "sync:watch": "node scripts/sync-knowledge.js watch",
    "contract": "node tests/contract.test.js",
    "contract:backend": "node tests/backend-contract.test.js",
    "seed:kp": "node scripts/seed-textbook-knowledge.js",
    "backfill:uid": "node scripts/backfill-question-uid.js",
    "gate": "bash scripts/release-gate.sh"
  },
  "dependencies": {
    "@playwright/test": "^1.61.1",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dompurify": "^3.3.1",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.16.33",
    "mammoth": "^1.12.0",
    "marked": "^17.0.4",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.0",
    "sharp": "^0.34.5",
    "word-extractor": "^1.0.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-prettier": "^5.5.6",
    "gitnexus": "^1.6.5",
    "jimp": "^1.6.1",
    "prettier": "^3.8.3",
    "qrcode": "^1.5.4",
    "supertest": "^7.2.2",
    "vitest": "^4.1.8"
  }
}
